[Unit]
Description=PACS — remote repository integrity and retention (%i)
Documentation=file:__DOCS_ROOT__/operations/remote_backups.md
Wants=network-online.target
After=network-online.target
__BACKUP_MOUNTS_LINE__

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
UMask=0077
Nice=15
IOSchedulingClass=idle
ExecStart=__PYTHON_BIN__ __REPO_ROOT__/scripts/backup/remote_backup.py maintain %i
TimeoutStartSec=infinity
