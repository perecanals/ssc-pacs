[Unit]
Description=PACS — nightly pg_dump backup of orthanc_db
Documentation=file:__DOCS_ROOT__/operations/backup_strategy.md

[Timer]
# Schedule from config.toml [backup.schedules]; defaults stagger local dumps.
OnCalendar=__BACKUP_CALENDAR__
RandomizedDelaySec=__BACKUP_JITTER__
Persistent=true
Unit=pg-backup-orthanc.service

[Install]
WantedBy=timers.target
