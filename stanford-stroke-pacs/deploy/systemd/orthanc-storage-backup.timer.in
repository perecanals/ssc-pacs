[Unit]
Description=PACS — nightly backup of the Orthanc storage volume
Documentation=file:__DOCS_ROOT__/operations/backup_strategy.md

[Timer]
# Schedule from config.toml [backup.schedules]; defaults stagger local backups.
OnCalendar=__BACKUP_CALENDAR__
RandomizedDelaySec=__BACKUP_JITTER__
Persistent=true
Unit=orthanc-storage-backup.service

[Install]
WantedBy=timers.target
