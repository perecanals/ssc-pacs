[Unit]
Description=PACS — nightly pg_dump backup of stanford-stroke
Documentation=file:__DOCS_ROOT__/operations/backup_strategy.md

[Timer]
# Schedule from config.toml [backup.schedules]. Catch up missed runs on boot.
OnCalendar=__BACKUP_CALENDAR__
RandomizedDelaySec=__BACKUP_JITTER__
Persistent=true
Unit=pg-backup-stanford-stroke.service

[Install]
WantedBy=timers.target
