[Unit]
Description=PACS — backup freshness monitor (PostgreSQL only on dev)
Documentation=file:__DOCS_ROOT__/operations/backup_strategy.md
# An unmounted backup root reads as "no backups at all" — a false alarm that
# trains people to ignore the real one. Rendered from config.toml's [backup].
__BACKUP_MOUNTS_LINE__

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
ExecStart=__REPO_ROOT__/scripts/backup/check_backup_freshness.sh
StandardOutput=journal
StandardError=journal
# A configured [backup].cold_mirror_dest is monitored automatically.
