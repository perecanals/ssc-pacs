[Unit]
Description=PACS — cold-archive mirror (Tier 2, dormant on dev)
Documentation=file:__DOCS_ROOT__/operations/backup_strategy.md
Wants=network-online.target
After=network-online.target
# Mirroring from an unmounted cold-archive root would silently mirror nothing
# over a good copy. Rendered from config.toml's [storage] roots.
__DATA_MOUNTS_LINE__

[Service]
Type=oneshot
User=__DEPLOY_USER__
Group=__DEPLOY_GROUP__
Nice=15
IOSchedulingClass=idle
# Activation in production:
#   1. Set config.toml [backup].cold_mirror_dest to a local/NFS directory.
#      SOURCE_DIR is NOT needed: mirror_cold_archive.sh defaults it to
#      config.toml [storage].cold_archive_root. Set it only to mirror some
#      other directory.
#   2. systemctl enable --now cold-archive-mirror.timer
#
# With an empty destination, the script no-ops with a notice (exit 0).
ExecStart=__REPO_ROOT__/scripts/cold_storage/mirror_cold_archive.sh
StandardOutput=journal
StandardError=journal
